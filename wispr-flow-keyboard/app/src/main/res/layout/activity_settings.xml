<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header Brand Block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Wispr Flow Logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wispr Flow"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Extended AI Voice Keyboard &amp; Typing Assistant"
                    android:textColor="@color/accent_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 1: SYSTEM SETUP & ENABLING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Step 1 &amp; 2: Keyboard Activation"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Step 1 Button -->
            <Button
                android:id="@+id/btnEnableKeyboard"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="1. Enable Wispr Flow in Settings"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_primary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:layout_marginBottom="10dp" />

            <!-- Step 2 Button -->
            <Button
                android:id="@+id/btnSelectKeyboard"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="2. Switch Active Keyboard"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvActivationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking setup..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- CARD 2: MICROPHONE PERMISSION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Microphone Dictation Permission"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvMicStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking microphone permission..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnGrantMicPermission"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Grant Microphone Permission"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CARD 3: GEMINI API KEY & MODEL SELECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Google Gemini AI Configuration"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your Gemini API key and select the AI model for real-time dictation polishing:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- API Key Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Gemini API Key:"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="Paste AIzaSy... (leave blank for offline rule mode)"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_key"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp" />

            <!-- Save Key Button -->
            <Button
                android:id="@+id/btnSaveApiKey"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Save API Key &amp; Fetch Available Models"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_primary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:layout_marginBottom="16dp" />

            <!-- Model Selection Dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select AI Model to Access:"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerModel"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:padding="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Default Flow Transformation Mode Dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default AI Voice Flow Mode:"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerMode"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:padding="10dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <!-- CARD 3.5: THEMES & KEYBOARD LAYOUT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Appearance &amp; Layout"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customize theme colors and layout separation."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Theme Dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Keyboard Theme:"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerTheme"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:padding="10dp"
                android:layout_marginBottom="14dp" />

            <!-- Number Row Toggle Checkbox -->
            <CheckBox
                android:id="@+id/cbShowNumberRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show permanent Number Row on Text Keyboard (Uncheck to keep Text &amp; Numbers separated)"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CARD 3.6: CONTACT CARD SCANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📇 Business &amp; Contact Card Scanner"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extracts contact information using Gemini Vision AI and delivers both structured text and card image with a single tap."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnLaunchScanner"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📸 Launch Contact Card Scanner"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_primary"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CARD 4: TEXT SHORTCUTS & CUSTOM EXPANSIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Text Shortcuts (e.g., GM ➔ Good Morning)"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAddShortcut"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Add"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_btn_primary"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type short codes on the keyboard to automatically expand full phrases:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <!-- Shortcuts Container List -->
            <LinearLayout
                android:id="@+id/llShortcutsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- CARD 5: TYPING PATTERN & COLLOCATION STATS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 Typing Patterns &amp; Collocations"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvPatternStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learned Words: 0 | Learned Collocations: 0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnResetPatterns"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Reset Learned Word &amp; Collocation History"
                android:textColor="@color/accent_red"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- CARD 6: INTERACTIVE TEST ARENA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨️ Keyboard Live Test Playground"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap below to bring up Wispr Flow. Try typing 'GM', testing suggestions, emojis, or pressing the 🎙️ mic button:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/etTestInput"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:hint="Tap here to bring up Wispr Flow Keyboard..."
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_key"
                android:gravity="top|start"
                android:padding="12dp"
                android:inputType="textMultiLine"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnTestSampleVoice"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🧪 Test AI Polishing Engine (Simulate Speech)"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
