<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_mic_listening" />
            <stroke
                android:width="2dp"
                android:color="#f87171" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#312e81" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_pink" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_mic_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/key_mic_stroke" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
