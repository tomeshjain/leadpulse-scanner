<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Brand Block -->
        <LinearLayout
            android:id="@+id/headerBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/smart_ai_logo"
                android:contentDescription="Smart AI Keyboard Logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:id="@+id/tvBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart AI Keyboard"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBrandSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart AI Voice Dictation &amp; Card Scanner"
                    android:textColor="@color/accent_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 1: SYSTEM SETUP & ENABLING -->
        <LinearLayout
            android:id="@+id/cardActivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Step 1 &amp; 2: Keyboard Activation"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activate Smart AI Keyboard in Android system settings and select it as your default input method:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Step 1 Button -->
            <Button
                android:id="@+id/btnEnableKeyboard"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="1. Enable Smart AI in Settings"
                android:textColor="#ffffff"
                android:background="@drawable/bg_btn_primary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Step 2 Button -->
            <Button
                android:id="@+id/btnSelectKeyboard"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="2. Switch to Smart AI Keyboard"
                android:textColor="@color/btn_secondary_text"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActivationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking setup..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- CARD 2: MICROPHONE PERMISSION -->
        <LinearLayout
            android:id="@+id/cardMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Microphone Dictation Permission"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvMicStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Checking microphone permission..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnGrantMicPermission"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Grant Microphone Permission"
                android:textColor="@color/btn_secondary_text"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 3: GEMINI AI CONFIGURATION -->
        <LinearLayout
            android:id="@+id/cardGemini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Google Gemini AI Configuration"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your Gemini API key and select the AI model for low-latency dictation polish and contact scanning:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- API Key Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Gemini API Key:"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:hint="Paste AIzaSy... (leave blank for offline rule mode)"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_key"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp" />

            <!-- Save Key Button -->
            <Button
                android:id="@+id/btnSaveApiKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Save API Key &amp; Fetch Available Models"
                android:textColor="#ffffff"
                android:background="@drawable/bg_btn_primary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Model Selection Dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select AI Model to Access (Default: gemini-2.0-flash low latency):"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerModel"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:padding="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Default Flow Transformation Mode Dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default AI Voice Flow Mode:"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerMode"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:padding="6dp"
                android:layout_marginBottom="4dp" />
        </LinearLayout>

        <!-- CARD 4: THEMES & KEYBOARD LAYOUT -->
        <LinearLayout
            android:id="@+id/cardAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 Appearance &amp; Layout"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clean Light theme is active by default. Selecting a theme instantly updates the keyboard and this settings screen:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Theme Dropdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Theme (Live Preview):"
                android:textColor="@color/accent_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerTheme"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_key"
                android:padding="6dp"
                android:layout_marginBottom="16dp" />

            <!-- Number Row Toggle Checkbox -->
            <CheckBox
                android:id="@+id/cbShowNumberRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show permanent Number Row on Text Keyboard (Uncheck to keep Text &amp; Numbers separated)"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- CARD 5: CONTACT CARD SCANNER -->
        <LinearLayout
            android:id="@+id/cardScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📇 Business &amp; Contact Card Scanner"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Captures business cards directly with camera, extracts details including LinkedIn &amp; Past Work, supports Voice Notes, and saves to phone contacts before sending:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnLaunchScanner"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📸 Launch Contact Card Scanner"
                android:textColor="#ffffff"
                android:background="@drawable/bg_btn_primary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 6: TEXT SHORTCUTS & CUSTOM EXPANSIONS -->
        <LinearLayout
            android:id="@+id/cardShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Text Shortcuts (e.g., GM ➔ Good Morning)"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAddShortcut"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="+ Add"
                    android:textColor="#ffffff"
                    android:background="@drawable/bg_btn_primary"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type short codes on the keyboard to automatically expand full phrases:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <!-- Shortcuts Container List -->
            <LinearLayout
                android:id="@+id/llShortcutsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- CARD 7: TYPING PATTERN & COLLOCATION STATS -->
        <LinearLayout
            android:id="@+id/cardPatterns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧠 Typing Patterns &amp; Collocations"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvPatternStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Learned Words: 0 | Learned Collocations: 0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnResetPatterns"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Reset Learned Word &amp; Collocation History"
                android:textColor="@color/accent_red"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 8: INTERACTIVE TEST ARENA -->
        <LinearLayout
            android:id="@+id/cardTesting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨️ Keyboard Live Test Playground"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap below to bring up Smart AI Keyboard. Try typing, testing suggestions, emojis, or pressing the 🎙️ mic button:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/etTestInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Tap here to bring up Smart AI Keyboard..."
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:background="@drawable/bg_key"
                android:gravity="top|start"
                android:padding="14dp"
                android:inputType="textMultiLine"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnTestSampleVoice"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🧪 Test AI Polishing Engine (Simulate Speech)"
                android:textColor="@color/btn_secondary_text"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD 9: PURE AI & GEMINI LIVE DIAGNOSTICS -->
        <LinearLayout
            android:id="@+id/cardAiDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 Pure AI &amp; Gemini Live Diagnostics"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspect raw model latencies, test pure AI execution without offline fallbacks, and verify Gemini Multimodal Live WebSocket connectivity:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnTestPureAiVoice"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🎙️ Test Pure AI Voice (Strict - No Fallback)"
                android:textColor="#ffffff"
                android:background="@drawable/bg_btn_primary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnTestPureAiCard"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📇 Test Pure AI Contact Card (Strict 6 Fields)"
                android:textColor="@color/btn_secondary_text"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnTestLiveWs"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="⚡ Test Gemini Multimodal Live (WebSocket wss://)"
                android:textColor="@color/btn_secondary_text"
                android:background="@drawable/bg_btn_secondary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvPureAiTestResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_key"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:typeface="monospace"
                android:padding="12dp"
                android:lineSpacingExtra="2dp"
                android:text="Diagnostic Console: Ready. Tap any test button above." />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
